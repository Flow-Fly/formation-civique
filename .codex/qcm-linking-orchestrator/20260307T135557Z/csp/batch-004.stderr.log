thinking
**Checking for ID validity**

I need to ensure that all the IDs I have are spelled correctly. It makes sense to run a check to see if any of the candidateFicheIds match actual files in the index or tree. I could use a script in Node to parse and verify that the IDs correspond to existing files. It might also be useful to check any related items within the candidates too. A quick script should make this easier!
codex
The file parses. I’m running one consistency check on fiche IDs before the final state refresh: every `relatedFicheIds` must be inside `candidateFicheIds`, and every fiche ID should exist in the fiche corpus.
exec
/bin/zsh -lc "node - <<'NODE'
const fs = require('fs');
const path = require('path');
const batch = JSON.parse(fs.readFileSync('data-init/suggestions/question-fiche-links.csp.r004.json', 'utf8'));
const files = [];
function walk(dir){ for(const ent of fs.readdirSync(dir,{withFileTypes:true})){ const p=path.join(dir,ent.name); if(ent.isDirectory()) walk(p); else if(ent.isFile() && p.endsWith('.json')) files.push(p);} }
walk('data-init/fiches');
const ids = new Set(files.map(f => JSON.parse(fs.readFileSync(f,'utf8')).id));
let ok = true;
for (const item of batch.items) {
  for (const id of item.relatedFicheIds) {
    if ("'!item.candidateFicheIds.includes(id)) {
      ok = false;
      console.log('"'related_not_in_candidates', item.questionId, id);
    }
  }
  for (const id of item.candidateFicheIds) {
    if ("'!ids.has(id)) {
      ok = false;
      console.log('"'missing_candidate_id', item.questionId, id);
    }
  }
}
console.log(ok ? 'ok' : 'fail');
