data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:2:  "id": "droits-et-devoirs--obligations-et-devoirs-des-personnes-residant-en-france--la-limite-des-libertes-individuelles",
data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:3:  "title": "La limite des libertés individuelles",
data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:8:  "url": "https://formation-civique.interieur.gouv.fr/fiches-par-thematiques/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles/",
data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:10:    "Comprendre les limites des libertés individuelles.Identifier des exemples concrets de restrictions de libertés individuelles en France."
data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:15:      "content": "De nombreux droits et libertés nous sont accordés par la Déclaration des Droits de l’Homme et du Citoyen et les autres textes fondamentaux. Il est écrit que nos droits sont “imprescriptibles” (article 2 de la DDHC), ce qui signifie qu’ils ne peuvent pas nous être retirés.\n\nCependant, ces droits et libertés ont une limite pour protéger la vie en société. Nos droits et libertés individuels sont limités par les droits des autres : \"La liberté consiste à faire tout ce qui ne nuit pas à autrui\" (article 4 de la DDHC).",
data-init/fiches/droits-et-devoirs/obligations-et-devoirs-des-personnes-residant-en-france/la-limite-des-libertes-individuelles.json:19:      "heading": "Quelles sont les limites de nos droits et libertés ?",

