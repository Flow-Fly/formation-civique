/bin/zsh -lc "node - <<'NODE'
const fs=require('fs');
function normalize(text){return String(text||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[’']/g,' ').replace(/["'^'"\\w\\s]/g,' ').replace(/\\s+/g,' ').trim();}
const payload=JSON.parse(fs.readFileSync('data-init/suggestions/answer-pools.pending.cr-b007.json','utf8'));
const idx=JSON.parse(fs.readFileSync('data-init/fiches-section-index.json','utf8'));
const sectionMap=new Map(idx.sections.map(s=>["'`${s.contentPath}#${s.sectionId}`,s]));
const issues=[];
for (const item of payload.items){
  const s=item.suggestion||{};
  if ((s.correct||[]).length!==1) issues.push(`${item.questionId}: correct count ${(s.correct||[]).length}`);
  if ((s.distractors||[]).length!==3) issues.push(`${item.questionId}: distractor count ${(s.distractors||[]).length}`);
  const ans=(s.answerEvidence||[])[0];
  if (!ans) { issues.push(`${item.questionId}: missing answerEvidence row`); continue; }
  if (normalize(ans.answerText)!==normalize((s.correct||[])[0])) issues.push(`${item.questionId}: answerEvidence text mismatch`);
  for (const ptr of [...(ans.evidence||[]), ...(s.questionEvidence||[])]){
    const key=`${ptr.contentPath}#${ptr.sectionId}`;
    const sec=sectionMap.get(key);
    if (!sec) { issues.push(`${item.questionId}: missing section ${key}`); continue; }
    if (!normalize(sec.sectionText).includes(normalize(ptr.quote))) issues.push(`${item.questionId}: quote not found in ${key}`);
  }
}
console.log(issues.length?issues.join('"'\\n'):'OK');
