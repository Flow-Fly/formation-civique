const map = new Map((idx.sections || []).map(s => ["'`${s.contentPath}#${s.sectionId}`, s]));
const issues = [];
for (const item of batch.items || []) {
  const s = item.suggestion || {};
  if ((s.correct || []).length !== 1) issues.push(`${item.questionId}: correct count ${(s.correct || []).length}`);
  if ((s.distractors || []).length !== 3) issues.push(`${item.questionId}: distractor count ${(s.distractors || []).length}`);
  if (!Array.isArray(s.answerEvidence) || s.answerEvidence.length !== 1) issues.push(`${item.questionId}: answerEvidence count ${(s.answerEvidence || []).length}`);
  if (!Array.isArray(s.questionEvidence) || s.questionEvidence.length < 1) issues.push(`${item.questionId}: questionEvidence missing`);
  const correct = (s.correct || [])[0];
  const row = (s.answerEvidence || [])[0];
  if (row && normalize(row.answerText) !== normalize(correct)) issues.push(`${item.questionId}: answerText mismatch`);
  if (row && normalize(row.normalizedAnswer) !== normalize(correct)) issues.push(`${item.questionId}: normalizedAnswer mismatch`);
  for (const ev of (row?.evidence || [])) {
    const sec = map.get(`${ev.contentPath}#${ev.sectionId}`);
    if (!sec) issues.push(`${item.questionId}: unknown answer section ${ev.contentPath}#${ev.sectionId}`);
    else if (!normalize(sec.sectionText).includes(normalize(ev.quote))) issues.push(`${item.questionId}: answer quote miss`);
    if (ev.ficheId && !(item.relatedFicheIds || []).includes(ev.ficheId)) issues.push(`${item.questionId}: answer fiche outside related`);
  }
  for (const ev of (s.questionEvidence || [])) {
    const sec = map.get(`${ev.contentPath}#${ev.sectionId}`);
    if (!sec) issues.push(`${item.questionId}: unknown question section ${ev.contentPath}#${ev.sectionId}`);
    else if (!normalize(sec.sectionText).includes(normalize(ev.quote))) issues.push(`${item.questionId}: question quote miss`);
    if (ev.ficheId && !(item.relatedFicheIds || []).includes(ev.ficheId)) issues.push(`${item.questionId}: question fiche outside related`);
  }
}
