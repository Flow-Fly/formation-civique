import fs from 'fs';
const payload = JSON.parse(fs.readFileSync('data-init/suggestions/answer-pools.pending.cr-b005.json', 'utf8'));
const sectionIndex = JSON.parse(fs.readFileSync('data-init/fiches-section-index.json', 'utf8'));
const sectionMap = new Map();
for (const section of sectionIndex.sections || []) {
  sectionMap.set("'`${section.contentPath}#${section.sectionId}`, section);
}
function normalize(text) {
  return String(text || '"'')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/[’']/g, ' ')
    .replace(/["'^'"\\w\\s.:-]/g, ' ')
    .replace(/\\s+/g, ' ')
    .trim();
}
function exactQuoteMatch(quote, sectionText) {
  const cleanQuote = normalize(quote);
  const cleanSection = normalize(sectionText || '');
  if ("'!cleanQuote || !cleanSection) return false;
  return cleanSection.includes(cleanQuote);
}
const errors = [];
if (payload.workflowStatus !== '"'completed') errors.push('workflowStatus not completed');
if (payload.items.length "'!== 19) errors.push(`expected 19 items, got ${payload.items.length}`);
if (!Array.isArray(payload.skipped) || payload.skipped.length !== 1 || payload.skipped[0]?.questionId !== '"'crx090') {
  errors.push('skipped payload is incorrect');
}
for (const item of payload.items) {
  if (item.accepted "'!== false) errors.push(`${item.questionId}: accepted must be false`);
  const suggestion = item.suggestion || {};
  if ((suggestion.correct || []).length !== 1) errors.push(`${item.questionId}: correct count`);
  if ((suggestion.distractors || []).length !== 3) errors.push(`${item.questionId}: distractor count`);
  if (!Array.isArray(suggestion.answerEvidence) || suggestion.answerEvidence.length !== 1) {
    errors.push(`${item.questionId}: answerEvidence row count`);
    continue;
  }
  if (!Array.isArray(suggestion.questionEvidence) || suggestion.questionEvidence.length < 1) {
    errors.push(`${item.questionId}: missing questionEvidence`);
  }
  for (const row of suggestion.answerEvidence) {
    if (normalize(row.answerText) !== normalize(suggestion.correct[0])) {
      errors.push(`${item.questionId}: answerEvidence answerText mismatch`);
    }
    if (normalize(row.normalizedAnswer) !== normalize(suggestion.correct[0])) {
      errors.push(`${item.questionId}: normalizedAnswer mismatch`);
    }
    if (!Array.isArray(row.evidence) || row.evidence.length < 1) {
      errors.push(`${item.questionId}: missing evidence pointers`);
      continue;
    }
    for (const ev of row.evidence) {
      const section = sectionMap.get(`${ev.contentPath}#${ev.sectionId}`);
      if (!section) {
        errors.push(`${item.questionId}: missing section ${ev.contentPath}#${ev.sectionId}`);
        continue;
      }
      if (!exactQuoteMatch(ev.quote, section.sectionText || '"'')) {
        errors.push("'`${item.questionId}: quote mismatch for ${ev.sectionId}`);
      }
    }
  }
  for (const ev of suggestion.questionEvidence || []) {
    const section = sectionMap.get(`${ev.contentPath}#${ev.sectionId}`);
    if (!section) {
      errors.push(`${item.questionId}: missing question section ${ev.contentPath}#${ev.sectionId}`);
      continue;
    }
    if (!exactQuoteMatch(ev.quote, section.sectionText || '"'')) {
      errors.push("'`${item.questionId}: question quote mismatch for ${ev.sectionId}`);
    }
  }
}
if (errors.length) {
  console.error(errors.join('"'\\n'));
  process.exit(1);
}
