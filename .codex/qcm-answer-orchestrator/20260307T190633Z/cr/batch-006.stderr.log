    const sec=map.get(`${ev.contentPath}#${ev.sectionId}`);
    if(!sec) errors.push(`${item.questionId}: missing question section ${ev.contentPath}#${ev.sectionId}`);
    else if(!normalize(sec.sectionText).includes(normalize(ev.quote))) errors.push(`${item.questionId}: quote not found for questionEvidence`);
  }
}
if(errors.length){console.log(errors.join('"'\\n')); process.exit(1);} 
