  if(item.accepted!==false) errors.push(`${item.questionId}: accepted must be false`);
  const s=item.suggestion||{};
  if((s.correct||[]).length!==1) errors.push(`${item.questionId}: correct count`);
  if((s.distractors||[]).length!==3) errors.push(`${item.questionId}: distractor count`);
  if(!(s.questionEvidence||[]).length) errors.push(`${item.questionId}: missing questionEvidence`);
  if(!(s.answerEvidence||[]).length) errors.push(`${item.questionId}: missing answerEvidence`);
  for(const row of s.answerEvidence||[]){
