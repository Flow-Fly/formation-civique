const map=new Map(sections.map(s=>["'`${s.contentPath}#${s.sectionId}`,s]));
let errors=[];
if(batch.workflowStatus!=='"'completed') errors.push('workflowStatus not completed');
if(batch.items.length"'!==18) errors.push(`expected 18 items, got ${batch.items.length}`);
if((batch.skipped||[]).length!==2) errors.push(`expected 2 skipped, got ${(batch.skipped||[]).length}`);
