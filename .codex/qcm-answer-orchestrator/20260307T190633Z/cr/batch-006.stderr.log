/bin/zsh -lc "node - <<'NODE'
const fs=require('fs');
const file='data-init/suggestions/answer-pools.pending.cr-b006.json';
const idx='data-init/fiches-section-index.json';
function normalize(text){return String(text||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[’']/g,' ').replace(/["'^'"\\w\\s]/g,' ').replace(/\\s+/g,' ').trim();}
const batch=JSON.parse(fs.readFileSync(file,'utf8'));
const sections=JSON.parse(fs.readFileSync(idx,'utf8')).sections;
const map=new Map(sections.map(s=>["'`${s.contentPath}#${s.sectionId}`,s]));
let errors=[];
if(batch.workflowStatus!=='"'completed') errors.push('workflowStatus not completed');
if(batch.items.length"'!==18) errors.push(`expected 18 items, got ${batch.items.length}`);
if((batch.skipped||[]).length!==2) errors.push(`expected 2 skipped, got ${(batch.skipped||[]).length}`);
for(const item of batch.items){
  if(item.accepted!==false) errors.push(`${item.questionId}: accepted must be false`);
  const s=item.suggestion||{};
  if((s.correct||[]).length!==1) errors.push(`${item.questionId}: correct count`);
  if((s.distractors||[]).length!==3) errors.push(`${item.questionId}: distractor count`);
  if(!(s.questionEvidence||[]).length) errors.push(`${item.questionId}: missing questionEvidence`);
  if(!(s.answerEvidence||[]).length) errors.push(`${item.questionId}: missing answerEvidence`);
  for(const row of s.answerEvidence||[]){
    if(!row.evidence?.length) errors.push(`${item.questionId}: empty answerEvidence row`);
    for(const ev of row.evidence||[]){
      const sec=map.get(`${ev.contentPath}#${ev.sectionId}`);
      if(!sec) errors.push(`${item.questionId}: missing section ${ev.contentPath}#${ev.sectionId}`);
      else if(!normalize(sec.sectionText).includes(normalize(ev.quote))) errors.push(`${item.questionId}: quote not found for answerEvidence`);
    }
  }
  for(const ev of s.questionEvidence||[]){
    const sec=map.get(`${ev.contentPath}#${ev.sectionId}`);
    if(!sec) errors.push(`${item.questionId}: missing question section ${ev.contentPath}#${ev.sectionId}`);
    else if(!normalize(sec.sectionText).includes(normalize(ev.quote))) errors.push(`${item.questionId}: quote not found for questionEvidence`);
  }
}
if(errors.length){console.log(errors.join('"'\\n')); process.exit(1);} 
console.log("'`Checked ${batch.items.length} items and ${(batch.skipped||[]).length} skipped entries with no structural/evidence errors.`);
