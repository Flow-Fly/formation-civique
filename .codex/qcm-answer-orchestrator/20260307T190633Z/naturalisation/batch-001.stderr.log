The batch file is written. I’m doing a read-only consistency pass now against the section index: counts, evidence presence, and whether each quote resolves to the referenced section without creating any extra output artifacts.
exec
/bin/zsh -lc "node - <<'NODE'
const fs = require('fs');
const batch = JSON.parse(fs.readFileSync('data-init/suggestions/answer-pools.pending.naturalisation-b001.json','utf8'));
const idx = JSON.parse(fs.readFileSync('data-init/fiches-section-index.json','utf8'));
const map = new Map(idx.sections.map(s => ["'`${s.contentPath}#${s.sectionId}`, s]));
const normalize = (text) => String(text || '"'')
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\\u0300-\\u036f]/g, '')
  .replace(/[’']/g, ' ')
  .replace(/["'^'"\\w\\s.:-]/g, ' ')
  .replace(/\\s+/g, ' ')
  .trim();
const problems = [];
if (batch.workflowStatus "'!== '"'completed') problems.push('workflowStatus not completed');
for (const item of batch.items || []) {
  if (item.accepted "'!== false) problems.push(`${item.questionId}: accepted must be false`);
  const s = item.suggestion || {};
  if (!Array.isArray(s.correct) || s.correct.length !== 1) problems.push(`${item.questionId}: correct count`);
  if (!Array.isArray(s.distractors) || s.distractors.length !== 3) problems.push(`${item.questionId}: distractor count`);
  if (!Array.isArray(s.answerEvidence) || s.answerEvidence.length !== 1) problems.push(`${item.questionId}: answerEvidence rows`);
  if (!Array.isArray(s.questionEvidence) || s.questionEvidence.length < 1) problems.push(`${item.questionId}: questionEvidence missing`);
  for (const row of s.answerEvidence || []) {
    if (normalize(row.answerText) !== normalize(row.normalizedAnswer)) {
      problems.push(`${item.questionId}: normalizedAnswer mismatch for ${row.answerText}`);
    }
    for (const ev of row.evidence || []) {
      const section = map.get(`${ev.contentPath}#${ev.sectionId}`);
      if (!section) {
        problems.push(`${item.questionId}: missing section ${ev.contentPath}#${ev.sectionId}`);
        continue;
      }
      if (!normalize(section.sectionText).includes(normalize(ev.quote))) {
        problems.push(`${item.questionId}: answer quote not found in ${ev.contentPath}#${ev.sectionId}`);
      }
    }
  }
  for (const ev of s.questionEvidence || []) {
    const section = map.get(`${ev.contentPath}#${ev.sectionId}`);
    if (!section) {
      problems.push(`${item.questionId}: missing question section ${ev.contentPath}#${ev.sectionId}`);
      continue;
    }
    if (!normalize(section.sectionText).includes(normalize(ev.quote))) {
      problems.push(`${item.questionId}: question quote not found in ${ev.contentPath}#${ev.sectionId}`);
    }
  }
}
if (problems.length) {
  console.log(JSON.stringify({ok:false, problems}, null, 2));
  process.exit(1);
}
console.log(JSON.stringify({ok:true, items:batch.items.length, skipped:(batch.skipped||[]).length}, null, 2));
